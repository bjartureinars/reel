 } DoviRpuContext;
 
+/**
+ * Profile 7 (base layer + enhancement layer, as on UHD Blu-ray) to profile 8.1 (the
+ * HDR10 base layer alone with the same dynamic metadata), like dovi_tool's mode 2:
+ * the residual is disabled and the mapping from base layer to output is the identity.
+ */
+static void convert_to_p81(AVDOVIMetadata *metadata)
+{
+    AVDOVIRpuDataHeader *hdr = (AVDOVIRpuDataHeader *) av_dovi_get_header(metadata);
+    AVDOVIDataMapping *mapping = (AVDOVIDataMapping *) av_dovi_get_mapping(metadata);
+
+    hdr->el_spatial_resampling_filter_flag = 0;
+    hdr->disable_residual_flag = 1;
+    mapping->nlq_method_idc = AV_DOVI_NLQ_NONE;
+    mapping->num_x_partitions = mapping->num_y_partitions = 1;
+    if (hdr->coef_data_type != RPU_COEFF_FIXED)
+        return;
+    for (int c = 0; c < 3; c++) {
+        AVDOVIReshapingCurve *curve = &mapping->curves[c];
+        memset(curve, 0, sizeof(*curve));
+        curve->num_pivots = 2;
+        curve->pivots[0] = 0;
+        curve->pivots[1] = (1 << hdr->bl_bit_depth) - 1;
+        curve->mapping_idc[0] = AV_DOVI_MAPPING_POLYNOMIAL;
+        curve->poly_order[0] = 1;
+        curve->poly_coef[0][0] = 0;
+        curve->poly_coef[0][1] = 1LL << hdr->coef_log2_denom;
+    }
+}
+
 static int update_rpu(AVBSFContext *bsf, const AVPacket *pkt, int flags,
                       const uint8_t *rpu, size_t rpu_size,
                       uint8_t **out_rpu, int *out_size)
@@ -66,6 +96,9 @@
